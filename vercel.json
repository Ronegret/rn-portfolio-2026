{
  "rewrites": [
    {
      "source": "/((?!.*\\.(html|js|css|png|jpg|jpeg|webp|svg|ico|woff|woff2|ttf|eot|gif|json|map|txt|xml)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
