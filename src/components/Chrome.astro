---
const ch = (w) => [...w];
---
<a href="#main" class="skip-link">Saltar al contenido principal</a>

<!-- INTRO — nombre cinético que estalla en las especialidades (decorativa, ~1,3 s; lógica en main.js + intro.js) -->
<div id="preloader" aria-hidden="true">
  <div class="in-meta in-meta-tl">Rodrigo Negrete · Barcelona</div>
  <div class="in-meta in-meta-br"><span id="pl-count">00</span></div>
  <div class="in-stage">
    <p class="in-word" style="--x:-34vw;--y:-30vh;--r:-4deg">AI Product Design</p>
    <p class="in-word" style="--x:30vw;--y:-22vh;--r:3deg">UX/UI</p>
    <p class="in-word" style="--x:-30vw;--y:28vh;--r:3deg">Automation</p>
    <p class="in-word" style="--x:28vw;--y:30vh;--r:-3deg">AI Agents</p>
    <div class="in-name">
      <span class="in-line in-l1" style="--d:.04s">{ch('RODRIGO').map((c, i) => <span class="in-ch" style={`--i:${i}`}>{c}</span>)}</span>
      <span class="in-line in-l2" style="--d:.14s">{ch('NEGRETE').map((c, i) => <span class="in-ch" style={`--i:${i}`}>{c}</span>)}<span class="in-dot"></span></span>
    </div>
  </div>
</div>
<script is:inline>
  /* Una vez por sesión (o ?intro=0): se retira antes del primer pintado. Si no, se bloquea el scroll con red de seguridad de 3 s */
  (function () {
    var d = document.documentElement, p = document.getElementById('preloader'), seen = false;
    try { seen = sessionStorage.getItem('intro_seen') === '1'; sessionStorage.setItem('intro_seen', '1'); } catch (e) {}
    if (p && (seen || /[?&]intro=0/.test(location.search))) { p.remove(); return; }
    d.classList.add('pl-locked');
    setTimeout(function () {
      d.classList.remove('pl-locked');
      if (document.body) document.body.classList.remove('pl-locked');
      var q = document.getElementById('preloader'); if (q) q.remove();
    }, 3000);
  })();
</script>

<div class="lang-curtain" id="lang-curtain" aria-hidden="true">
  <div class="lang-curtain-top"></div>
  <div class="lang-curtain-bot"></div>
  <div class="lang-curtain-beam"></div>
  <div class="lang-curtain-label" id="lang-curtain-label">Español</div>
</div>

<!-- Cursor personalizado clásico (dot + halo) -->
<div id="cur"></div>
<div id="cur-r"></div>
<div id="prog"></div>
<div id="camera-flash"></div>
<canvas id="bg-cv"></canvas>

