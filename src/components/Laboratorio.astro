---
import '../sx-lab.css';
// Registro del laboratorio. Fecha: no hay fecha fiable por pieza; se usa el año del commit que la añadió al portfolio (fe9e145, 2026-06-07).
const TYPES = [
  { k: 'all', i: 'lx_f_all', t: 'Todo' },
  { k: 'ia', i: 'lx_f_ia', t: 'IA' },
  { k: 'web', i: 'lx_f_web', t: 'Web' },
  { k: 'proto', i: 'lx_f_proto', t: 'Prototipos' },
  { k: 'marca', i: 'lx_f_marca', t: 'Marca personal' },
];
const label = Object.fromEntries(TYPES.map((x) => [x.k, x]));
const items = [
  { name: 'AIbueno.es', href: 'https://aibueno.es', dom: 'aibueno.es', img: '/assets/aibueno-preview.png', fit: 'contain', type: 'ia', active: true,
    meta: { i: 'lab_ai_h', t: 'AIbueno.es — Agencia de IA y Desarrollo Web' }, d: { i: 'lab_ai_d', t: 'Proyecto propio de Barcelona enfocado en desarrollo web, apps móviles y agentes de IA para practicar propuesta de valor, automatización y captación.' },
    pills: [{ i: 'lab_p1', t: 'Agentes IA' }, { i: 'lab_p2', t: 'Desarrollo Web' }, { i: 'lab_p3', t: 'Apps Móviles' }, { t: 'Barcelona' }] },
  { name: 'Jukaa Tattoo', href: 'https://jukaatattoo.rodd.es', dom: 'jukaatattoo.rodd.es', img: '/assets/legacy/jukaa.webp', type: 'web', meta: { t: 'Premium · Ink Network' }, d: { i: 'l1_d', t: 'Identidad visual oscura y premium. Booking online y galería de artistas.' } },
  { name: 'Ink Madrid', href: 'https://inkmadrid.rodd.es', dom: 'inkmadrid.rodd.es', img: '/assets/legacy/inkmadrid.webp', type: 'web', meta: { t: 'Urban · Ink Network' }, d: { i: 'l2_d', t: 'Estilo urbano, diseño orientado a conversión con CTA de booking prominente.' } },
  { name: 'Ink BCN', href: 'https://inkbcn.rodd.es', dom: 'inkbcn.rodd.es', img: '/assets/legacy/inkbcn.webp', type: 'web', meta: { i: 'lab_t3', t: 'Minimalista · Ink Network' }, d: { i: 'l3_d', t: 'Estética minimalista barcelonesa. Layout limpio y alta legibilidad.' } },
  { name: 'Alto Foco Studio', href: 'https://altofoco.rodd.es', dom: 'altofoco.rodd.es', img: '/assets/legacy/altofoco.webp', type: 'ia', meta: { i: 'lab_t4', t: 'Agencia · Lead Gen IA' }, d: { i: 'l4_d', t: 'Plataforma minimalista con IA que captura leads cualificados.' } },
  { name: 'Vortex Immersive', href: 'https://vortex.rodd.es', dom: 'vortex.rodd.es', img: '/assets/legacy/vortex.webp', type: 'proto', meta: { t: 'UX Lab · WebGL' }, d: { i: 'l5_d', t: 'Experimento 3D interactivo con WPO extremo para 60fps fluidos.' } },
  { name: 'La Óptica Online', href: 'https://laopticaonline.rodd.es', dom: 'laopticaonline.rodd.es', img: '/assets/legacy/laoptinaonline.jpg', type: 'proto', meta: { t: 'E-commerce · CRO' }, d: { i: 'l6_d', t: 'Prototipo e-commerce orientado a conversión bruta. Checkout optimizado.' } },
  { name: 'CV Digital', href: '/cv/', dom: '/cv', img: '/assets/profile/ver-cv.jpg', pos: 'center top', type: 'marca', meta: { t: 'Marca personal · ATS' }, d: { i: 'l7_d', t: 'Currículum web optimizado para reclutadores: lectura rápida, PDF descargable, SEO profesional y estructura compatible con ATS.' } },
  { name: 'RodrigoNegrete.es', href: '#hero', dom: 'rodrigonegrete.es', img: '/assets/seo/rodrigo-negrete-og.webp', type: 'marca', meta: { i: 'lab_t8', t: 'Portfolio · Sistema vivo' }, d: { i: 'l8_d', t: 'Portfolio modular con 5 sistemas visuales, SEO social, casos de estudio, rutas independientes y arquitectura lista para escalar desde WordPress a código.' } },
];
const count = (k) => (k === 'all' ? items.length : items.filter((x) => x.type === k).length);
const pad = (n) => String(n).padStart(2, '0');
---
<section class="sec" id="laboratorio">
  <div class="wrap">
    <span class="sec-n" data-n="04" aria-hidden="true"></span>
    <p class="eyebrow rv" data-i="lab_ey">Laboratorio digital</p>
    <h2 class="sh rv" data-i="lab_h">Laboratorio de producto:<br><em>UX, IA y automatización.</em></h2>
    <p class="sb rv" data-i="lab_sub">Además de los casos principales, mantengo un laboratorio de webs, herramientas y experimentos para validar UX, IA aplicada, automatización, SEO y medición.</p>

    <div class="lx rv" data-lx>
      <div class="lx-bar">
        <p class="lx-file"><span class="lx-pulse" aria-hidden="true"></span>lab.log <span class="lx-dim">· {items.length} <span data-i="lx_entries">entradas</span></span></p>
        <span class="lx-sr" id="lx-fl" data-i="lx_filter_l">Filtrar por tipo</span>
        <div class="lx-filters" role="group" aria-labelledby="lx-fl" hidden>
          {TYPES.map((x) => (
            <button type="button" class="lx-f" data-k={x.k} aria-pressed={x.k === 'all' ? 'true' : 'false'}>
              <span data-i={x.i}>{x.t}</span><sup>{count(x.k)}</sup>
            </button>
          ))}
        </div>
      </div>

      <div class="lx-year" aria-hidden="true"><span>2026</span><i></i><span class="lx-dim" data-i="lx_src">año del commit que añadió cada pieza</span></div>
      <ul class="lx-list" role="list">
        {items.map((x, n) => (
          <li class="lx-row" data-type={x.type} data-img={x.img} style={`--n:${n}`}>
            <details class="lx-d" name="lx">
              <summary class="lx-s">
                <span class="lx-no">{pad(n + 1)}</span>
                <span class="lx-name">{x.name}{x.active && <span class="lx-live"><i aria-hidden="true"></i><span data-i="lab_ai_act">Proyecto activo</span></span>}</span>
                <span class="lx-type" data-i={label[x.type].i}>{label[x.type].t}</span>
                <span class="lx-dom">{x.dom}</span>
                <span class="lx-plus" aria-hidden="true"></span>
              </summary>
              <div class="lx-body">
                <div class="lx-txt">
                  <p class="lx-meta" data-i={x.meta.i}>{x.meta.t}</p>
                  <p class="lx-desc" data-i={x.d.i}>{x.d.t}</p>
                  {x.pills && <p class="lx-pills">{x.pills.map((p) => <span data-i={p.i}>{p.t}</span>)}</p>}
                  <a class="lx-go trigger-flash" href={x.href} {...(x.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                    <span data-i="lx_open">Abrir</span> {x.dom}<span aria-hidden="true"> ↗</span>
                  </a>
                </div>
                <figure class="lx-thumb"><img src={x.img} alt="" loading="lazy" decoding="async" style={`object-fit:${x.fit || 'cover'};object-position:${x.pos || 'center'}`}></figure>
              </div>
            </details>
          </li>
        ))}
      </ul>
      <p class="lx-empty" hidden data-i="lx_empty">Sin entradas de este tipo.</p>
    </div>
  </div>
  <div class="lx-pv" aria-hidden="true"></div>
</section>
<script>import '../sx-lab.js';</script>
