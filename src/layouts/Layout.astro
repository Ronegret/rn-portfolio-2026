---
import '../styles.css';
import Chrome from '../components/Chrome.astro';
import Dock from '../components/Dock.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { AVATARS } from '../islands/themes.js';
import vtCore from '../../public/src/case-transitions.js?raw';
---
<!DOCTYPE html>
<html lang="es" data-theme="saas">
<head>
<meta charset="UTF-8">
<style is:inline>@view-transition{navigation:auto}</style><!-- opt-in antes de los <link> que bloquean el render: si llega despues Chrome aborta la transicion -->
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5,viewport-fit=cover">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230a0a0a'/%3E%3Ctext x='32' y='43' font-family='Arial,sans-serif' font-size='30' font-weight='800' text-anchor='middle' fill='%23fff'%3ERN%3C/text%3E%3Ccircle cx='51' cy='13' r='5' fill='%23ff2d2d'/%3E%3C/svg%3E">
  <meta name="description" content="Rodrigo Negrete — AI Product Designer especializado en agentes IA, hiperautomatización y diseño de producto con IA aplicada. Máster EBIS en Agentes de IA. +17 años previos en negocio B2B enterprise (Movistar/Telefónica). Proyectos reales en producción: Rodd.es, ZODI, Dedícalo Play. Barcelona · Remoto EU · Freelance.">
  <meta name="keywords" content="Rodrigo Negrete, AI Product Designer Barcelona, Product Designer AI, AI Automation Specialist, Prompt Engineer Barcelona, UX UI Designer con IA, Design Technologist, hiperautomatización, agentes IA, LLM, RAG, prompt engineering, Figma, React, Next.js, WordPress, n8n, Make, Botpress, Vapi, OpenAI, Claude, Gemini, ZODI, Invitoo, remoto EU">
  <meta name="author" content="Rodrigo Negrete">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <link rel="canonical" href="https://rodrigonegrete.es/">
  <title>Rodrigo Negrete — AI Product Designer · UX/UI + Automatización IA</title>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_ES">
  <meta property="og:site_name" content="Rodrigo Negrete Portfolio">
  <meta property="og:url" content="https://rodrigonegrete.es/">
  <meta property="og:title" content="Rodrigo Negrete — AI Product Designer · UX/UI + Automatización IA">
  <meta property="og:description" content="Portfolio de AI Product Designer: producto digital, UX/UI, IA aplicada y automatización. Casos reales — Rodd.es open source multilingüe, ZODI en producción, Just Enjoy (TFM en equipo), Iberdata CoE IA y más.">
  <meta property="og:image" content="https://rodrigonegrete.es/assets/seo/rodrigo-negrete-og.jpg">
  <meta property="og:image:secure_url" content="https://rodrigonegrete.es/assets/seo/rodrigo-negrete-og.jpg">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="633">
  <meta property="og:image:alt" content="Portfolio Rodrigo Negrete — AI Product Designer con UX/UI e IA aplicada">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Rodrigo Negrete — AI Product Designer · UX/UI + IA">
  <meta name="twitter:description" content="Diseño producto digital y automatizo flujos con IA aplicada. Del research al agente en producción. Máster EBIS + 17 años negocio B2B.">
  <meta name="twitter:image" content="https://rodrigonegrete.es/assets/seo/rodrigo-negrete-og.jpg">
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Rodrigo Negrete",
    "url": "https://rodrigonegrete.es/",
    "image": "https://rodrigonegrete.es/assets/seo/rodrigo-negrete-og.jpg",
    "jobTitle": "AI Product Designer · AI Automation Specialist · UX/UI",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Barcelona",
      "addressCountry": "ES"
    },
    "knowsAbout": [
      "UX/UI Design",
      "Product Design",
      "Artificial Intelligence",
      "AI Automation",
      "Design Systems",
      "Figma",
      "React",
      "WordPress",
      "n8n",
      "Make",
      "Botpress"
    ],
    "description": "AI Product Designer especializado en agentes IA, hiperautomatización de procesos y diseño de producto con IA aplicada. Máster EBIS en Agentes de IA. Domino Make, n8n, Botpress, Vapi, Claude, GPT y Gemini. +17 años previos gestionando cuentas B2B enterprise (Movistar/Telefónica). Proyectos propios en producción: Rodd.es (biblioteca open source multilingüe), ZODI (AI product), Dedícalo Play. Trabajos de máster: Just Enjoy (TFM en equipo; frontend, diseño UX/UI e interfaces y parte de la automatización en n8n) e Iberdata (business case)."
  }
  </script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@300;400;500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Outfit:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,500;0,700;1,400;1,700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" media="print" onload="this.media='all'">
<noscript>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@300;400;500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Outfit:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,500;0,700;1,400;1,700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</noscript>

<!-- Transiciones de pagina: logica compartida con los casos (public/src/case-transitions.js), inline para estar lista antes del primer pintado -->
<script is:inline set:html={vtCore}></script>
<script is:inline>try{if((sessionStorage.getItem('rn-vt')||'').includes('back')){var l=document.createElement('link');l.rel='expect';l.href='#proyectos';l.setAttribute('blocking','render');document.head.appendChild(l)}}catch(e){}</script>
</head>
<body>
<Chrome />
<Dock />
<Nav />
<main id="main">
  <slot />
</main>
<Footer />
<script>
  import '../main.js';
  import '../transitions.js';
  import '../hero-polish.js';
</script>
<!-- Tema persistido: se aplica antes del primer pintado (el body ya esta parseado); las islas hidratan despues sin salto -->
<script is:inline define:vars={{ AVATARS }}>try{var t=sessionStorage.getItem('rn-theme');if(t&&AVATARS[t]){document.documentElement.setAttribute('data-theme',t);var a=document.getElementById('av');if(a)a.src=AVATARS[t];document.querySelectorAll('.dk,.tc').forEach(function(b){var on=(b.dataset.t||b.dataset.tc)===t;b.classList.toggle('on',on);b.setAttribute('aria-pressed',on)})}}catch(e){}</script>
<script is:inline>addEventListener("load",()=>setTimeout(()=>document.querySelectorAll("img[data-src]").forEach(i=>{if(i.dataset.srcset)i.srcset=i.dataset.srcset;i.src=i.dataset.src}),300))</script>
</body>
</html>
