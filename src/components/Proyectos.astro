      <div class="rv" data-d="2" data-cats="ecom">
        <a href="/paratumundo/" class="bc trigger-flash">
          <div class="bc-img" style="background:#fff"><img src="/assets/legacy/logo-paratumundo.png" alt="ParaTuMundo — UX marketplace e-commerce" loading="lazy"></div>
          <div class="bc-bd">
            <div class="bc-tags"><span class="bc-tag">E-commerce · UX Research · Shopify</span></div>
            <h3 class="bc-h" data-i="p5_h">ParaTuMundo — Estrategia UX para marketplace</h3>
            <p class="bc-d" data-i="p5_d">Research competitivo, DAFO, encuestas, personas, journey map, arquitectura de información y prototipo Figma para un e-commerce multcategoría.</p>
            <div class="bc-m">33 encuestas · Shopify · BigBuy</div>
            <span class="bc-link" data-i="see_proj">Ver proyecto →</span>
          </div>
        </a>
      </div>
      <div class="rv" data-d="3" data-cats="ux">
        <a href="/te-atiendo/" class="bc trigger-flash">
          <div class="bc-img" style="background:#fff"><img src="/assets/legacy/logo-teatiendo.png" alt="Te Atiendo — UX para servicio en mesa" loading="lazy"></div>
          <div class="bc-bd">
            <div class="bc-tags"><span class="bc-tag">Gastro-Tech · UX Research · Service Design</span></div>
            <h3 class="bc-h" data-i="p6_h">Te Atiendo — UX para servicio en mesa</h3>
            <p class="bc-d" data-i="p6_d">Producto digital para restaurantes: research, DAFO, benchmarking, journey map, gamificación del staff, feedback en tiempo real y prototipo Figma.</p>
            <div class="bc-m">20 encuestas y entrevistas · benchmark · Figma</div>
            <span class="bc-link" data-i="see_proj">Ver proyecto →</span>
          </div>
        </a>
      </div>
      <div class="rv" data-d="1" data-cats="ux saas">
        <a href="/aquae/" class="bc trigger-flash">
          <div class="bc-img" style="background:#fff"><img src="/assets/legacy/logo-aquae.png" alt="Aquae — App sostenibilidad y ahorro hídrico" loading="lazy"></div>
          <div class="bc-bd">
            <div class="bc-tags"><span class="bc-tag" data-i="p7_tag">App Móvil</span></div>
            <h3 class="bc-h">Aquae</h3>
            <p class="bc-d" data-i="p7_d">Aplicación móvil concebida para la sostenibilidad. Adopta técnicas de gamificación y ciencia de datos para incentivar el ahorro hídrico.</p>
            <span class="bc-link" data-i="see_proj">Ver proyecto →</span>
          </div>
        </a>
      </div>
      <div class="rv" data-d="2" data-cats="ux ecom">
        <a href="/travel-of-vapers/" class="bc trigger-flash">
          <div class="bc-img" style="background:#fff"><img src="/assets/legacy/logo-travel-of-vapers.png" alt="Travel of Vapers — Branding y packaging" loading="lazy"></div>
