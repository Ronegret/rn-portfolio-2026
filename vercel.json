{
  "framework": "astro",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/deep-detection-discovery",
      "destination": "/deep-detection-access/",
      "permanent": false,
      "missing": [
        { "type": "cookie", "key": "dd_discovery_access", "value": "granted" }
      ]
    },
    {
      "source": "/deep-detection-discovery/",
      "destination": "/deep-detection-access/",
      "permanent": false,
      "missing": [
        { "type": "cookie", "key": "dd_discovery_access", "value": "granted" }
      ]
    },
    {
      "source": "/deep-detection-discovery/:path*",
      "destination": "/deep-detection-access/",
      "permanent": false,
      "missing": [
        { "type": "cookie", "key": "dd_discovery_access", "value": "granted" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/Zodi", "destination": "/zodi-bto/index.html" },
    { "source": "/Zodi/", "destination": "/zodi-bto/index.html" },
    { "source": "/zodi", "destination": "/zodi/index.html" },
    { "source": "/zodi/", "destination": "/zodi/index.html" },
    { "source": "/zodi-bto", "destination": "/zodi-bto/index.html" },
    { "source": "/zodi-bto/", "destination": "/zodi-bto/index.html" },

    { "source": "/dedicalo-play", "destination": "/dedicalo-play/index.html" },
    { "source": "/dedicalo-play/", "destination": "/dedicalo-play/index.html" },

    { "source": "/pdf", "destination": "/pdf-rodd/index.html" },
