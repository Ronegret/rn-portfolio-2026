---
// Imagen de tarjeta: webp + srcset con width/height reales (astro:assets).
// defer=true conserva el diferido por data-src/data-srcset (se activa en el evento load, ver Layout).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; alt: string; defer?: boolean; sizes?: string; }
const { src, alt, defer = false, sizes = '(max-width: 860px) 92vw, 540px' } = Astro.props;

const widths = [480, 800, 1200].filter((w) => w < src.width);
const variants = await Promise.all(widths.map((w) => getImage({ src, width: w, format: 'webp' })));
const main = await getImage({ src, width: Math.min(800, src.width), format: 'webp' });
const srcset = variants.map((v, i) => `${v.src} ${widths[i]}w`).join(', ') || undefined;
const px = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
---
{defer
  ? <img src={px} data-src={main.src} data-srcset={srcset} sizes={srcset ? sizes : undefined} alt={alt} width={main.attributes.width} height={main.attributes.height} loading="lazy" decoding="async" />
  : <img src={main.src} srcset={srcset} sizes={srcset ? sizes : undefined} alt={alt} width={main.attributes.width} height={main.attributes.height} loading="lazy" decoding="async" />}
