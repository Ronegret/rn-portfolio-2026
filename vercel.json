    { "source": "/deep-detection-discovery", "destination": "/deep-detection-discovery/index.html" },
    { "source": "/deep-detection-discovery/", "destination": "/deep-detection-discovery/index.html" },
    { "source": "/dedicalo", "destination": "/dedicalo/index.html" },
    { "source": "/dedicalo/", "destination": "/dedicalo/index.html" },
    { "source": "/invitoo", "destination": "/invitoo/index.html" },
    { "source": "/invitoo/", "destination": "/invitoo/index.html" },
    { "source": "/Invitoo", "destination": "/invitoo/index.html" },
