    { "source": "/te-atiendo", "destination": "/te-atiendo/index.html" },
    { "source": "/te-atiendo/", "destination": "/te-atiendo/index.html" },
    { "source": "/teatiendo", "destination": "/te-atiendo/index.html" },
    { "source": "/teatiendo/", "destination": "/te-atiendo/index.html" },
    { "source": "/TeAtiendo", "destination": "/te-atiendo/index.html" },
