    { "source": "/Rodd/", "destination": "/rodd-es/index.html" },

    { "source": "/kettelbro", "destination": "/kettelbro/index.html" },
    { "source": "/kettelbro/", "destination": "/kettelbro/index.html" },
    { "source": "/Kettelbro", "destination": "/kettelbro/index.html" },
    { "source": "/Kettelbro/", "destination": "/kettelbro/index.html" },
    { "source": "/capsule-corp", "destination": "/capsule-corp/index.html" },
    { "source": "/capsule-corp/", "destination": "/capsule-corp/index.html" },
    { "source": "/Capsule-Corp", "destination": "/capsule-corp/index.html" },
    { "source": "/Capsule-Corp/", "destination": "/capsule-corp/index.html" },
    { "source": "/portfolio-2026", "destination": "/portfolio-2026/index.html" },
    { "source": "/portfolio-2026/", "destination": "/portfolio-2026/index.html" },
    { "source": "/Portfolio-2026", "destination": "/portfolio-2026/index.html" },
    { "source": "/Portfolio-2026/", "destination": "/portfolio-2026/index.html" },
    { "source": "/aem", "destination": "/aem/index.html" },
    { "source": "/aem/", "destination": "/aem/index.html" },
    { "source": "/AEM", "destination": "/aem/index.html" },
