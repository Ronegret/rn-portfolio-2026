---
import '../sx-contacto.css';
import { execSync } from 'node:child_process';
import pkg from '../../package.json';
// System card: datos reales del build. Fecha, commit y stack se leen aquí; peso de la portada y nº de páginas los escribe
// scripts/sx-system-card.mjs al terminar el build (sustituye los "—" de [data-sys]).
const built = new Date();
const iso = built.toISOString().slice(0, 10);
let commit = (process.env.VERCEL_GIT_COMMIT_SHA || '').slice(0, 7);
if (!commit) { try { commit = execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); } catch { commit = ''; } }
const major = (r) => (r || '').replace(/[^\d.]/g, '').split('.')[0];
const stack = `Astro ${major(pkg.dependencies.astro)} · React ${major(pkg.dependencies.react)} · CSS/JS`;
---
<footer class="fx-footer" aria-labelledby="fx-brand">
  <div class="fx-glow" aria-hidden="true"></div>
  <div class="fx-grid-bg" aria-hidden="true"></div>

  <div class="fx-wrap">

    <!-- BRAND STRIP: nombre gigante con gradient + status -->
    <div class="fx-brand-row">
      <div class="fx-brand-block">
        <div class="fx-status">
          <span class="fx-status-dot" aria-hidden="true"></span>
          <span class="fx-status-txt" data-i="foot_status">Disponible ahora · Barcelona · Remoto EU</span>
        </div>
        <h2 id="fx-brand" class="fx-brand" aria-label="Rodrigo Negrete">
          <span class="fx-brand-fst">Rodrigo</span>
          <span class="fx-brand-snd">Negrete<span class="fx-brand-dot" aria-hidden="true"></span></span>
        </h2>
        <p class="fx-tag" data-i="foot_role">AI Product Designer · UX/UI + Automatización IA</p>
      </div>

      <a href="mailto:rodrigo.negrete.aros@gmail.com" class="fx-cta trigger-flash">
        <span class="fx-cta-lbl" data-i="foot_cta">Iniciar conversación</span>
        <span class="fx-cta-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
        </span>
      </a>
    </div>

    <!-- COLUMNS: navegación + contacto + redes -->
    <div class="fx-cols">
      <div class="fx-col">
        <p class="fx-col-h" data-i="foot_nav_h">Navegación</p>
        <ul class="fx-list">
          <li><a href="#hero" class="fx-lnk"><span data-i="nav_about">Sobre mí</span><span class="fx-arw">↗</span></a></li>
          <li><a href="#stack" class="fx-lnk"><span data-i="nav_stack">Stack</span><span class="fx-arw">↗</span></a></li>
          <li><a href="#proyectos" class="fx-lnk"><span data-i="nav_projects">Proyectos</span><span class="fx-arw">↗</span></a></li>
          <li><a href="#laboratorio" class="fx-lnk"><span data-i="nav_lab">Lab</span><span class="fx-arw">↗</span></a></li>
          <li><a href="#trayectoria" class="fx-lnk"><span data-i="nav_career">Trayectoria</span><span class="fx-arw">↗</span></a></li>
        </ul>
      </div>

      <div class="fx-col">
        <p class="fx-col-h" data-i="foot_proj_h">Proyectos destacados</p>
        <ul class="fx-list">
          <li><a href="/rodd-es/" class="fx-lnk"><span>Rodd.es · Biblioteca</span><span class="fx-arw fx-arw-new">✦</span></a></li>
          <li><a href="/aem/" class="fx-lnk"><span>Events Planner · Wedding</span><span class="fx-arw fx-arw-new">✦</span></a></li>
          <li><a href="https://db.rodrigonegrete.es/" target="_blank" rel="noopener" class="fx-lnk"><span>Capsule Corp · Portfolio DBZ</span><span class="fx-arw fx-arw-new">✦</span></a></li>
          <li><a href="/zodi/" class="fx-lnk"><span>ZODI · AI Product</span><span class="fx-arw">↗</span></a></li>
          <li><a href="/dedicalo-play/" class="fx-lnk"><span>Dedícalo Play</span><span class="fx-arw">↗</span></a></li>
          <li><a href="/just-enjoy/" class="fx-lnk"><span>Just Enjoy · TFM</span><span class="fx-arw">↗</span></a></li>
          <li><a href="/iberdata/" class="fx-lnk"><span>Iberdata · CoE IA</span><span class="fx-arw">↗</span></a></li>
        </ul>
      </div>

      <div class="fx-col">
        <p class="fx-col-h" data-i="foot_contact_h">Contacto directo</p>
        <ul class="fx-list">
          <li><a href="mailto:rodrigo.negrete.aros@gmail.com" class="fx-lnk"><span>rodrigo.negrete.aros@gmail.com</span><span class="fx-arw">✉</span></a></li>
          <li><a href="https://wa.me/34653567610" target="_blank" rel="noopener" class="fx-lnk"><span>+34 653 567 610</span><span class="fx-arw">💬</span></a></li>
          <li><a href="/cv/" class="fx-lnk"><span>Ver CV completo</span><span class="fx-arw">📄</span></a></li>
        </ul>
        <div class="fx-social">
          <a href="https://linkedin.com/in/rodrigonegretearos" target="_blank" rel="noopener" class="fx-soc" aria-label="LinkedIn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2zM8 19H5v-9h3v9zM6.5 8.25A1.75 1.75 0 1 1 8.3 6.5a1.78 1.78 0 0 1-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0 0 13 14.19a.66.66 0 0 0 0 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 0 1 2.7-1.4c1.55 0 3.36.86 3.36 3.66z"/></svg>
          </a>
          <a href="https://github.com/Ronegret" target="_blank" rel="noopener" class="fx-soc" aria-label="GitHub">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.1.83-.26.83-.58v-2.03c-3.34.72-4.04-1.6-4.04-1.6-.55-1.38-1.34-1.75-1.34-1.75-1.1-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.3 3.5 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.94 0-1.31.47-2.38 1.24-3.22-.13-.31-.54-1.54.12-3.2 0 0 1-.32 3.3 1.23a11.4 11.4 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.89.12 3.2.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5z"/></svg>
          </a>
          <a href="https://rodd.es" target="_blank" rel="noopener" class="fx-soc" aria-label="Rodd.es">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </a>
          <a href="/assets/legacy/Certificado%20EBIS%20IA.pdf" target="_blank" rel="noopener" class="fx-soc" aria-label="Certificado EBIS">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3 7v6c0 5 4 8.5 9 9 5-.5 9-4 9-9V7l-9-5z"/><path d="m8 12 3 3 5-6"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- SYSTEM CARD: métricas reales del build (sin cifras a mano) -->
    <div class="sys" data-sys-card aria-labelledby="sys-h" role="group">
      <div class="sys-head">
        <p class="sys-h" id="sys-h"><span class="sys-dot" aria-hidden="true"></span>system card <span class="sys-dim">· rodrigonegrete.es</span></p>
        <p class="sys-src sys-dim" data-i="sys_src">Datos medidos en el build, no escritos a mano</p>
      </div>
      <dl class="sys-grid">
        <div class="sys-m"><dt data-i="sys_kb">Peso de la portada</dt><dd><span class="sys-v">≈ <b data-sys="kb">—</b> KB</span><small data-i="sys_kb_n">gzip · HTML, CSS, JS, fuentes e imágenes iniciales</small></dd></div>
        <div class="sys-m"><dt data-i="sys_pages">Páginas publicadas</dt><dd><span class="sys-v"><b data-sys="pages">—</b></span><small data-i="sys_pages_n">HTML en el build</small></dd></div>
        <div class="sys-m"><dt data-i="sys_date">Último build</dt><dd><span class="sys-v"><time datetime={built.toISOString()}>{iso}</time></span><small>{commit ? <>commit <code>{commit}</code></> : 'local'}</small></dd></div>
        <div class="sys-m"><dt>Stack</dt><dd><span class="sys-v sys-v-sm">{stack}</span><small data-i="sys_stack_n">Estático · islas React · sin plantillas</small></dd></div>
      </dl>
    </div>

    <!-- BOTTOM LINE: idioma + copyright + made-with -->
    <div class="fx-bottom">
      <div class="fx-lang">
        <button class="fx-lang-btn on" data-lang="es" type="button" aria-label="ES, Español">ES</button>
        <button class="fx-lang-btn" data-lang="ca" type="button" aria-label="CA, Català">CA</button>
        <button class="fx-lang-btn" data-lang="en" type="button" aria-label="EN, English">EN</button>
      </div>
      <p class="fx-meta">
        <span>© 2026 Rodrigo Negrete Aros</span>
        <span class="fx-meta-sep">·</span>
        <span data-i="foot_made">Construido con Astro, React y CSS/JS a medida. Sin plantillas.</span>
      </p>
      <a href="#hero" class="fx-top trigger-flash" aria-label="Volver arriba">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
      </a>
    </div>

    <!-- MEGA WORDMARK: nombre gigante decorativo -->
    <div class="fx-wordmark" aria-hidden="true">
      <span>RODRIGO&nbsp;NEGRETE</span>
    </div>

  </div>
</footer>

<audio id="rn-audio" preload="none" loop>
  <source src="/audio/No_Hago_Pantallas.mp3" type="audio/mpeg">
</audio>

<div id="music-player" class="music-player" hidden role="complementary" aria-label="Reproductor de música">
  <div class="mp-row1">
    <span class="mp-note" aria-hidden="true">♪</span>
    <div class="mp-info">
      <span class="mp-title">No Hago Pantallas</span>
      <span class="mp-artist">Rodrigo Negrete</span>
    </div>
    <button class="mp-close" id="mp-close" aria-label="Cerrar reproductor">✕</button>
  </div>
  <div class="mp-prog-wrap">
    <div class="mp-prog"><div class="mp-prog-fill" id="mp-fill"></div></div>
    <span class="mp-time" id="mp-time">0:00</span>
  </div>
  <div class="mp-ctrl">
    <button class="mp-btn-ctrl" id="mp-mute" aria-label="Silenciar">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
    </button>
    <button class="mp-btn-ctrl mp-btn-main" id="mp-play" aria-label="Pausar">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
    </button>
  </div>
</div>

<!-- Certificate Lightbox — abre PDFs de EBIS/Neoland/DUOC en horizontal a pantalla completa -->
<dialog id="cert-lightbox" class="cert-lb" aria-labelledby="cert-lb-title">
  <div class="cert-lb-inner">
    <div class="cert-lb-head">
      <div class="cert-lb-meta">
        <span class="cert-lb-badge" id="cert-lb-badge">Certificado</span>
        <h3 id="cert-lb-title">Título del certificado</h3>
      </div>
      <div class="cert-lb-actions">
        <a id="cert-lb-download" href="#" download class="cert-lb-btn cert-lb-btn-alt">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          <span>Descargar PDF</span>
        </a>
        <button type="button" id="cert-lb-close" class="cert-lb-btn cert-lb-close-btn" aria-label="Cerrar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    <div class="cert-lb-frame">
      <iframe id="cert-lb-iframe" title="Vista previa del certificado" src="" loading="lazy"></iframe>
      <div class="cert-lb-fallback">
        <p>Si el certificado no se carga, ábrelo en una pestaña nueva:</p>
        <a id="cert-lb-openext" href="#" target="_blank" rel="noopener" class="cert-lb-btn">Abrir en pestaña nueva ↗</a>
      </div>
    </div>
  </div>
</dialog>
