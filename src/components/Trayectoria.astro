---
import '../sx-trayectoria.css';

/* Trayectoria como `git log --graph`: tres ramas (producto/ia, formacion, negocio-b2b) en columnas.
   lanes: estado de cada columna en la fila -> b = nace aqui (tramo inferior), f = pasa, t = termina aqui (raiz, tramo superior), '' = no existe.
   Orden: por fecha de fin (lo vigente arriba). Textos = los de siempre (claves data-i de content.js); el hash es decorativo. */
const PDF = '/assets/legacy/';
const rows = [
  { lane: 0, type: 'feat', head: true, curr: true, role: ['j1_role', 'AI Product Designer & Automation Consultant'], org: ['j1_co', 'Proyectos propios / Freelance'], date: '2021–hoy', lanes: ['b', '', ''],
    desc: ['j1_desc', 'Diseño producto digital e implanto flujos de IA aplicada para clientes propios y proyectos personales, del research a la puesta en producción. Casos propios: Rodd.es (biblioteca open source multilingüe) y ZODI (AI product en producción). Trabajos del máster: Just Enjoy (TFM en equipo; mi parte: frontend, diseño UX/UI e interfaces y parte de la automatización en n8n) e Iberdata (business case de CoE IA para empresa de 450).'],
    tags: ['Product Design', 'Design Systems', 'AI Agents', 'Make', 'React'] },
  { lane: 2, type: 'ops', curr: true, role: ['j2_role', 'Gestor de Cobros Empresas +Orange'], org: [null, 'Abai Group (antes Atento España, vía Adecco) · Cliente Orange Empresas · Barcelona'], date: '2024–hoy', lanes: ['f', '', 'b'],
    desc: ['j2_desc', 'Gestión de cartera B2B para empresas +Orange, seguimiento de deuda, incidencias, acuerdos de pago y coordinación operativa. Aplico criterio de negocio, datos y automatizaciones ligeras para mejorar trazabilidad y eficiencia.'],
    tags: ['Cobros B2B', 'Orange Empresas', 'Excel', 'Operaciones'] },
  { lane: 1, type: 'learn', wip: true, role: ['e2_t', 'Especialización en IA Generativa'], org: [null, 'UDIA (Universidad de IA)'], date: '2025–2026', lanes: ['f', 'b', 'f'],
    desc: ['e2_d', 'Prompt engineering avanzado, fine-tuning de modelos y producción de activos digitales con herramientas generativas de última generación.'] },
  { lane: 1, type: 'learn', role: ['e1_t', 'Máster en Agentes de IA e Hiperautomatización de Procesos'], org: [null, 'EBIS Business Techschool · Barcelona'], date: 'Nov. 2025 – Ago. 2026', lanes: ['f', 'f', 'f'],
    desc: ['e1_d', 'Máster finalizado en EBIS Business Techschool con TFM sobre hiperautomatización de procesos con agentes IA y examen final del CoE IA. Certificado oficial emitido en blockchain pública Polygon — ref. Y1D458ZGS2.'],
    cert: { pdf: PDF + 'Certificado%20EBIS%20IA.pdf', key: 'e1_cert', chain: 'https://polygonscan.com/tx/0x240e0561b003e8095fec82147e41b091cfc064b9e8b77a3cd2f864b6b5b54274' } },
  { lane: 1, type: 'learn', fork: true, role: ['e3_t', 'Bootcamp UX/UI Design — Professional Track'], org: [null, 'Neoland Madrid'], date: '2024', lanes: ['t', 'f', 'f'],
    desc: ['e3_d', 'Design Thinking, User Research, prototipado en Figma, Design Systems, Agile UX y Lean UX. 300 horas de práctica intensiva con proyectos reales.'],
    cert: { pdf: PDF + 'Neoland.pdf', key: 'e3_cert' } },
  { lane: 2, type: 'ops', role: ['j3_role', 'Encargado de local y coordinador de equipo'], org: [null, 'Garden España · Barcelona'], date: '2022–2024', lanes: ['', 'f', 'f'],
    desc: ['j3_desc', 'Responsable de la operativa diaria del local y de la atención al cliente: liderazgo del equipo, turnos y tareas, logística de producto, caja y eventos, con estándares de calidad del servicio. Mejora de procesos para reducir errores.'],
    tags: ['Team Leadership', 'Atención al cliente', 'Operaciones'] },
  { lane: 2, type: 'feat', role: ['j5_role', 'Founder E-commerce · UX/UI & Web Designer'], org: [null, 'ParaTuMundo · Barcelona'], date: '2022–2023', lanes: ['', 'f', 'f'],
    desc: ['j5_desc', 'Fundé y gestioné un e-commerce en Shopify: investigación de mercado, propuesta de valor, arquitectura, catálogo, páginas de producto, contenido, SEO, analítica y optimización de conversión (CRO).'],
    tags: ['Shopify', 'UX Research', 'SEO', 'CRO'] },
  { lane: 1, type: 'learn', role: ['e4_t', 'Diseño Web Multimedia y Marketing Digital'], org: [null, 'CIPSA.NET · Barcelona'], date: '2020–2022', lanes: ['', 'f', 'f'],
    desc: ['e4_d', 'Front-end development, HTML/CSS/JS, WordPress, Digital Marketing, SEO/SEM y fundamentos de UX aplicados a negocios digitales.'] },
  { lane: 2, type: 'init', role: ['j4_role', 'Account Manager / Asesor Comercial'], org: [null, 'Atento Chile (servicio a Movistar Empresas) · Chile'], date: '2008–2019', lanes: ['', 'f', 't'],
    desc: ['j4_desc', 'Cartera de más de 100 grandes empresas en Santiago de Chile (Atento Chile, servicio a Movistar Empresas, 2008–2016): atención personalizada, negociación de contratos, cierre de acuerdos y fidelización de cuentas estratégicas. De 2016 a 2019, analista de facturación: control del ciclo de facturación y exactitud de reportes.'],
    tags: ['Enterprise Sales', 'KAM', 'B2B Strategy', 'Customer Retention'] },
  { lane: 1, type: 'init', role: ['e5_t', 'Técnico en Administración Financiera'], org: [null, 'Instituto Profesional Duoc UC · Santiago, Chile'], date: '2014–2016', lanes: ['', 't', ''],
    desc: ['e5_d', 'Título Técnico de Nivel Superior. Contabilidad, gestión financiera, análisis de estados financieros y administración de operaciones. Base de business acumen que aplico hoy diseñando producto B2B con IA.'],
    cert: { pdf: PDF + 'Duoc.pdf', key: 'e5_cert' } },
];
const BR = [['br_p', 'producto/ia'], ['br_f', 'formación'], ['br_n', 'negocio-b2b']];
// Hash corto decorativo y estable (FNV-1a del titulo)
const hash = (s) => { let h = 2166136261; for (const c of s) h = Math.imul(h ^ c.charCodeAt(0), 16777619); return (h >>> 0).toString(16).padStart(8, '0').slice(0, 7); };
const shield = '<svg viewBox="0 0 24 24" fill="none" width="12" height="12" aria-hidden="true"><path d="M12 2 3 7v6c0 5 4 8.5 9 9 5-.5 9-4 9-9V7l-9-5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m8 12 3 3 5-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<section class="sec" id="trayectoria">
  <div class="wrap">
    <span class="sec-n" data-n="05" aria-hidden="true"></span>
    <p class="eyebrow rv" data-i="car_ey">Experiencia profesional</p>
    <h2 class="sh rv" data-i="car_h">Trayectoria <em>no convencional.</em></h2>
    <p class="sb rv" data-i="car_sub">Una transición profesional hacia UX/Product apoyada en negocio B2B, operaciones, tecnología e IA aplicada.</p>

    <div class="sx-tr rv">
      <div class="sx-tr-top">
        <p class="sx-tr-cmd" aria-hidden="true"><span class="sx-tr-cwd">~/rodrigo</span> <b>$</b> git log --graph --decorate</p>
        <p class="sx-tr-legend"><span class="sx-tr-legend-l" data-i="tr_legend">Ramas</span>{BR.map(([k, t], i) => <span class={`sx-tr-key c${i}`}><i aria-hidden="true"></i><span data-i={k}>{t}</span></span>)}</p>
      </div>

      <ol class="sx-tr-log">
        {rows.map((r, i) => {
          const id = `sx-tr-${i + 1}`;
          return (
            <li class:list={['sx-tr-row', `c${r.lane}`, `n-${r.lanes[r.lane]}`, { 'is-head': r.head }]} style={`--c:${r.lane}`}>
              <span class="sx-tr-g" aria-hidden="true">
                {r.lanes.map((s, c) => s && <i class={`sx-tr-ln s-${s} c${c}`} style={`--c:${c}`}></i>)}
                {r.fork && <i class="sx-tr-fk c0"></i>}
                {r.lanes[r.lane] !== 'b' && <i class="sx-tr-pl"></i>}
                <b class="sx-tr-nd"></b>
              </span>
              <div class="sx-tr-main">
                <h3 class="sx-tr-h">
                  <button type="button" class="sx-tr-btn" id={`${id}-b`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`${id}-d`}>
                    <span class="sx-tr-meta">
                      <span class="sx-tr-hash" aria-hidden="true">{hash(r.role[1])}</span>
                      <span class="sx-tr-date">{r.date}</span>
                      <span class="sx-tr-br"><span data-i={BR[r.lane][0]}>{BR[r.lane][1]}</span></span>
                      {r.head && <span class="sx-tr-dec sx-tr-headp" aria-hidden="true">HEAD</span>}
                      {r.curr && <span class="sx-tr-dec" data-i="curr">Actual</span>}
                      {r.wip && <span class="sx-tr-dec sx-tr-wip" data-i="in_progress">En Curso</span>}
                      {r.cert && <span class="sx-tr-dec sx-tr-ok"><Fragment set:html={shield} /><span data-i="tr_verified">Verificado</span></span>}
                    </span>
                    <span class="sx-tr-msg"><span class="sx-tr-type" aria-hidden="true">{r.type}:</span> <span data-i={r.role[0]}>{r.role[1]}</span></span>
                    <span class="sx-tr-org" data-i={r.org[0]}>{r.org[1]}</span>
                    <span class="sx-tr-chv" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  </button>
                </h3>
                <div class="sx-tr-bd" id={`${id}-d`} role="region" aria-labelledby={`${id}-b`}>
                  <div class="sx-tr-bi">
                    <p class="sx-tr-desc" data-i={r.desc[0]}>{r.desc[1]}</p>
                    {r.tags && <ul class="sx-tr-tags">{r.tags.map((t) => <li><span aria-hidden="true">+</span>{t}</li>)}</ul>}
                    {r.cert && (
                      <p class="sx-tr-acts">
                        <a href={r.cert.pdf} target="_blank" rel="noopener" class="edu-cert sx-tr-cert"><Fragment set:html={shield} /><span data-i={r.cert.key}>Ver certificado (PDF)</span></a>
                        {r.cert.chain && <a href={r.cert.chain} target="_blank" rel="noopener" class="edu-cert edu-cert-alt sx-tr-cert"><svg viewBox="0 0 24 24" fill="none" width="12" height="12" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M14 10a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><span data-i="e1_verify">Verificar en blockchain</span></a>}
                      </p>
                    )}
                  </div>
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>
<script>import '../sx-trayectoria.js';</script>
